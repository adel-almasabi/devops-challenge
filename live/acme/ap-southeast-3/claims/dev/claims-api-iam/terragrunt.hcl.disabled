# DISABLED on purpose: this role is not created until the claims team confirms the backend service account name.
# To enable: confirm the name (see ASSUMPTION below), then rename this file to terragrunt.hcl.
# Terragrunt only reads files named terragrunt.hcl, so this file is ignored until then.

include "root" {
  path = find_in_parent_folders()
}

terraform {
  source = "${get_repo_root()}/modules//irsa-role"
}

dependency "eks" {
  config_path = "../../../platform/dev/eks"

  mock_outputs = {
    oidc_provider_arn = "arn:aws:iam::111111111111:oidc-provider/oidc.eks.ap-southeast-3.amazonaws.com/id/MOCK"
  }
  mock_outputs_allowed_terraform_commands = ["validate", "plan"]
}

dependency "documents" {
  config_path = "../claims-documents-bucket"

  mock_outputs = {
    bucket_arn = "arn:aws:s3:::acme-claims-documents-dev"
  }
  mock_outputs_allowed_terraform_commands = ["validate", "plan"]
}

# Role for the claims backend, so it can upload claim documents without any access key.
#
# ASSUMPTION, to confirm with the claims team before applying: the backend runs in the `claims` namespace
# with a service account called `claims-api`. The role only trusts that exact name. If the real name is
# different, the pod will get `AccessDenied` on AssumeRoleWithWebIdentity (the same failure as the
# claims-worker incident), so check the service account name in the backend's Helm values first.
inputs = {
  name              = "claims-api-dev"
  oidc_provider_arn = dependency.eks.outputs.oidc_provider_arn
  namespace         = "claims"
  service_account   = "claims-api"

  policy_statements = [
    {
      # Upload only. No read, list or delete. This also covers the parts of a multipart upload.
      sid       = "UploadClaimDocuments"
      effect    = "Allow"
      actions   = ["s3:PutObject"]
      resources = ["${dependency.documents.outputs.bucket_arn}/*"]
    },
  ]
}
